{
  "dataset": "llff",
  "scene": "orchids",
  "images": "data/llff/orchids/images",
  "preprocessing": {
    "mask-grid-size": 4,
    "mask-reprompt-missing-fraction": 0.15,
    "mask-depth-quantile-high": 98.0,
    "mask-edge-restoration": true,
    "point-refinement": "knn"
  },
  "train": {
    "mask_2d_bg_margin": 1,
    "inpaint_at_iter": 30000,
    "refine_after_inpaint": true,
    "refine_iterations": 7000
  },
  "eval_iteration": 30000,
  "paper": {
    "iou": 0.666,
    "boundary_iou": 0.485,
    "accuracy": 0.935,
    "fg_psnr": 8.24,
    "bg_psnr": 10.98
  },
  "notes": {
    "paper_run": "PAMGS output/rigidgs/llff/orchids/WACV2027_Round2/Full_RigidGS_Training_1px",
    "prompt_sensitivity": "Thin petals/stems and overlapping leaves make the SAM 2 mask sensitive to click placement. Matching the paper's mask closely usually takes a few corrective points, not just the first click -- see 'A note on exact reproducibility' in the README."
  }
}
