{
  "dataset": "llff",
  "scene": "flower",
  "images": "data/llff/flower/images",
  "preprocessing": {
    "mask-grid-size": 1,
    "mask-reprompt-missing-fraction": 0.1,
    "mask-depth-quantile-high": 99.99,
    "point-refinement": "knn"
  },
  "train": {
    "mask_2d_bg_margin": 1,
    "inpaint_at_iter": 30000,
    "refine_after_inpaint": true,
    "refine_iterations": 7000
  },
  "eval_iteration": 30000,
  "paper": {
    "iou": 0.968,
    "boundary_iou": 0.792,
    "accuracy": 0.993,
    "fg_psnr": 25.46,
    "bg_psnr": 22.83
  },
  "notes": {
    "paper_run": "PAMGS output/rigidgs/llff/flower/WACV2027_Round2/Full_RigidGS_Training_1px",
    "prompt_sensitivity": "Thin stem/petal structure makes the SAM 2 mask sensitive to click placement. Matching the paper's mask closely usually takes a few corrective points, not just the first click -- see 'A note on exact reproducibility' in the README."
  }
}
